# Sunwell Studio — copy to .env and fill in values
# Optional: Ollama is the default LLM provider (no key needed)

# OpenAI (optional, for OpenAI models)
# OPENAI_API_KEY=sk-...

# Debug and logging
# SUNWELL_DEBUG=false
# SUNWELL_LOG_LEVEL=INFO

# State directory override (default: XDG_DATA_HOME/sunwell or ~/.local/share/sunwell)
# SUNWELL_STATE_DIR=
